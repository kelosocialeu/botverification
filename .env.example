# Compte qui publie les annonces
BOT_IDENTIFIER=certifications.kelosocial.eu
BOT_PASSWORD=xxxx-xxxx-xxxx-xxxx

# PDS du compte bot.
BOT_SERVICE=https://pds.kelosocial.eu

# Registre officiel des certifications Kelo Social sur AT Protocol.
CERTIFICATION_REPO=kelosocial.eu
CERTIFICATION_PDS=https://eurosky.social

# AppView public utilisé pour afficher les handles et noms des comptes.
PUBLIC_APPVIEW=https://public.api.bsky.app

# Surveillance toutes les 60 secondes.
POLL_INTERVAL_MS=60000

# Après un redémarrage, le bot peut reprendre les certifications des 5 dernières minutes.
STARTUP_GRACE_MS=300000
